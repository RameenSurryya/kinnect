<?xml version="1.0" encoding="utf-8"?>
<!--
    Kinnect colour tokens. Every value was sampled from the design PNGs with
    tools/sample_colors.py (median of many pixels, so compression noise cancels out).
    See docs/DESIGN_TOKENS.md for where each colour was sampled.
-->
<resources>

    <!-- Brand -->
    <color name="teal">#0B5F63</color>              <!-- primary: buttons, active tab, links -->
    <color name="teal_tint">#E3EFEF</color>         <!-- selected chip, "New" band, add-friend circle -->

    <!-- Surfaces -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="background">#F3F2EE</color>        <!-- warm off-white: login, sign up, menu -->
    <color name="surface">#FFFFFF</color>           <!-- feed, lists, cards, inputs -->
    <color name="chip_fill">#ECE9E2</color>         <!-- chips, grey buttons, search fields, bubbles -->
    <color name="divider">#E0E0DE</color>           <!-- 1dp lines under bars and between rows -->
    <color name="border">#D6D1C8</color>            <!-- input and card outlines -->
    <color name="card_border">#E4E0D8</color>       <!-- lighter outline of the recent login card (02) -->
    <color name="section_band">#E6E3DA</color>      <!-- thick gap between feed sections -->
    <color name="track">#D6D0C9</color>             <!-- empty progress / strength segments, sheet handle -->
    <color name="card_shadow">#E8E6E2</color>       <!-- soft line under white cards (19) -->
    <color name="thread_line">#D2D1CC</color>       <!-- curved lines joining replies to a comment (06) -->
    <color name="dashed_outline">#A4A39F</color>    <!-- dashed profile photo circle (03) -->

