<resources>
    <!--
        App theme: light, no action bar (every screen draws its own top bar).
        AppCompat (not Material) so a plain <Button> keeps our drawable backgrounds instead of
        being turned into a tinted MaterialButton.
        System bars are transparent: BaseActivity calls enableEdgeToEdge() and each screen root
        uses android:fitsSystemWindows="true", so the screen's own background colour shows
        behind the status bar and the gesture bar.
    -->
    <style name="Base.Theme.Kinnect" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryDark">@color/teal</item>
        <item name="colorAccent">@color/teal</item>                <!-- checkboxes, radios, cursor -->
        <item name="colorControlNormal">@color/text_grey</item>    <!-- unchecked boxes -->
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_grey</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>      <!-- dark icons on light screens -->
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Shared top bar: large circles by default (Home, 04) -->
        <item name="topBarSearchFrameStyle">@style/Kinnect.TopBar.SearchFrame</item>
        <item name="topBarMessengerFrameStyle">@style/Kinnect.TopBar.MessengerFrame</item>
        <item name="topBarCircleStyle">@style/Kinnect.TopBar.Circle</item>
        <item name="topBarBadgeStyle">@style/Kinnect.TopBar.Badge</item>
    </style>

    <style name="Theme.Kinnect" parent="Base.Theme.Kinnect" />

    <!-- Small top bar circles (14, 18, 19, 23). Use it on the include, so only the top bar changes:
         <include layout="@layout/include_top_bar" android:theme="@style/ThemeOverlay.Kinnect.TopBarSmall" /> -->
    <style name="ThemeOverlay.Kinnect.TopBarSmall" parent="">
        <item name="topBarSearchFrameStyle">@style/Kinnect.TopBar.SearchFrame.Small</item>
        <item name="topBarMessengerFrameStyle">@style/Kinnect.TopBar.MessengerFrame.Small</item>
        <item name="topBarCircleStyle">@style/Kinnect.TopBar.Circle.Small</item>
        <item name="topBarBadgeStyle">@style/Kinnect.TopBar.Badge.Small</item>
    </style>

    <!-- Dark screens (splash, camera, story editor/viewer, your story, voice call):
         light status bar icons on the dark or teal background. -->
    <style name="Theme.Kinnect.Dark" parent="Base.Theme.Kinnect">
        <item name="android:windowBackground">@color/camera_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash (01): teal window, so the screen is teal from the first frame.
         values-v31/themes.xml adds the Android 12+ system splash settings on top. -->
    <style name="Base.Theme.Kinnect.Splash" parent="Theme.Kinnect.Dark">
        <item name="android:windowBackground">@color/teal</item>
    </style>

    <style name="Theme.Kinnect.Splash" parent="Base.Theme.Kinnect.Splash" />
</resources>
