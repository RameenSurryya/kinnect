<?xml version="1.0" encoding="utf-8"?>
<!--
    Kinnect view styles. Apply with style="@style/Kinnect.Text.Body" etc.
    Text: Bricolage Grotesque for headings, Figtree for everything else (docs/DESIGN_TOKENS.md).
    Sizes and colours come from dimens.xml and colors.xml, never typed here directly.
-->
<resources>

    <!-- ===== Text ===== -->

    <!-- Base for all text: Figtree Regular, dark, body size. -->
    <style name="Kinnect.Text" parent="">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <!-- "kinnect" wordmark in the home top bar (04). -->
    <style name="Kinnect.Text.Wordmark">
        <item name="android:fontFamily">@font/bricolage_grotesque_extrabold</item>
        <item name="android:textSize">@dimen/text_wordmark</item>
        <item name="android:textColor">@color/teal</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Large white wordmark under the splash logo (01). -->
    <style name="Kinnect.Text.Wordmark.Splash">
        <item name="android:textSize">@dimen/text_wordmark_splash</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- "from" above "SMD" on the splash (01): soft white. -->
    <style name="Kinnect.Text.SplashFrom">
        <item name="android:textSize">@dimen/text_splash_from</item>
        <item name="android:textColor">@color/text_on_teal_soft</item>
    </style>

    <!-- "SMD" on the splash (01): Bricolage ExtraBold capitals, tracked out
         (letter-by-letter overlap with the design: Bricolage 800 0.89, Figtree 700 0.61). -->
    <style name="Kinnect.Text.SplashCompany">
        <item name="android:fontFamily">@font/bricolage_grotesque_extrabold</item>
        <item name="android:textSize">@dimen/text_splash_company</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <!-- Page titles (Friends, Notifications, Menu, Marketplace, Chats) and big
         onboarding questions ("What's your name and birthday?"). -->
    <style name="Kinnect.Text.Heading">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">@dimen/heading_line_spacing</item>
    </style>

    <!-- Page title in the shared top bar (Friends, Notifications, Menu, Marketplace): the
         heading size without the tighter tracking, as measured on 14, 18, 19, 23. -->
    <style name="Kinnect.Text.PageTitle">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">@dimen/text_heading</item>
    </style>

    <!-- Big name under a profile photo (15, 17). -->
    <style name="Kinnect.Text.ProfileName">
        <item name="android:fontFamily">@font/bricolage_grotesque_extrabold</item>
        <item name="android:textSize">@dimen/text_profile_name</item>
    </style>

    <!-- Toolbar titles next to a back arrow (Create account, Comments, Lina's post). -->
    <style name="Kinnect.Text.Title">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <!-- Section titles inside a page ("Friend requests", "Today's picks", "Details"). -->
    <style name="Kinnect.Text.SectionTitle">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">@dimen/text_section_title</item>
    </style>

    <!-- Smaller list headers ("New", "Earlier", "People", "Groups"). -->
    <style name="Kinnect.Text.SectionTitle.Small">
        <item name="android:textSize">@dimen/text_section</item>
    </style>

    <!-- Person or item name in a list row (Sara Iqbal in 14, Jacob West in 02). -->
    <style name="Kinnect.Text.Name">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">@dimen/text_name</item>
    </style>

    <!-- Running text: posts, bubbles, notifications. Slightly airier lines than the font's own. -->
    <style name="Kinnect.Text.Body">
        <item name="android:lineSpacingExtra">@dimen/body_line_spacing</item>
    </style>

    <!-- Bold name inside body text ("Lina Marsh is at ..."). -->
    <style name="Kinnect.Text.Body.Bold">
        <item name="android:fontFamily">@font/figtree_semibold</item>
    </style>

    <!-- Grey secondary line under a name ("8 mutual friends", "Tap to log in", "2h"). -->
    <style name="Kinnect.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_grey</item>
    </style>

    <!-- Bold name in the recent login card (02): heavier than a list name. -->
    <style name="Kinnect.Text.Name.Bold">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">@dimen/text_name_large</item>
    </style>

    <!-- Grey line under a name in a card ("Tap to log in", 02). -->
    <style name="Kinnect.Text.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_grey</item>
    </style>

    <!-- Grey bold label above a group ("All shortcuts", "RECENT LOGIN"). -->
    <style name="Kinnect.Text.Label">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_grey</item>
    </style>

    <!-- Bold capitals label ("RECENT LOGIN", 02). -->
    <style name="Kinnect.Text.Label.Bold">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">@dimen/text_label_bold</item>
    </style>

    <!-- Small label inside a field ("Mobile number or email", "Password"): caption size,
         set slightly tighter, as measured on 02. -->
    <style name="Kinnect.Text.FieldLabel" parent="Kinnect.Text.Caption">
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <!-- Teal text link ("See all", "Forgot password?", "Find friends"). -->
    <style name="Kinnect.Text.Link">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/teal</item>
    </style>

    <!-- ===== Buttons ===== -->
    <!-- Base: removes the default Button extras (minimum size, ALL CAPS, raised shadow). -->
    <style name="Kinnect.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Teal pill, full width: Log in, Create account. -->
    <style name="Kinnect.Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_name</item>
    </style>

    <!-- Outlined pill: Create new account. -->
    <style name="Kinnect.Button.Outline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height_outline</item>
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/teal</item>
        <item name="android:textSize">@dimen/text_name</item>
    </style>

    <!-- Small teal button with 10dp corners: Confirm, Join, Add to story. -->
    <style name="Kinnect.Button.Small">
        <item name="android:layout_height">@dimen/button_height_small</item>
        <item name="android:background">@drawable/bg_button_small</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Small grey button with 10dp corners: Delete, Edit profile. -->
    <style name="Kinnect.Button.Small.Grey">
        <item name="android:background">@drawable/bg_button_grey</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <!-- Full-width grey button: See more, See all people, See previous notifications. -->
    <style name="Kinnect.Button.Grey">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height_medium</item>
        <item name="android:background">@drawable/bg_button_grey</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <!-- ===== Inputs ===== -->

    <!-- Rounded white field (02, 03). -->
    <style name="Kinnect.Input" parent="">
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">@dimen/input_padding</item>
        <item name="android:paddingEnd">@dimen/input_padding</item>
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textSize">@dimen/text_name</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Field with a small label above the value (02, 03): the white rounded box is a vertical
         LinearLayout holding a Kinnect.Text.Caption label and a Kinnect.FieldText EditText. -->
    <style name="Kinnect.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/input_padding</item>
        <item name="android:paddingEnd">@dimen/input_padding</item>
        <!-- balances the gap above the value, so the label stays where the design has it -->
        <item name="android:paddingTop">@dimen/field_value_gap</item>
    </style>

    <!-- The EditText inside a Kinnect.Field: no box or padding of its own (the field draws it). -->
    <style name="Kinnect.FieldText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/field_value_gap</item>
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textSize">@dimen/text_name</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Grey pill field: search (13, 20), Write a reply (06), Aa (21). -->
    <style name="Kinnect.Input.Search">
        <item name="android:layout_height">@dimen/input_height_search</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Dropdown box (03 Day / Month / Year): a FrameLayout holding a Spinner, a small label
         and a chevron. Width comes from layout_weight. -->
    <style name="Kinnect.Dropdown" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_input</item>
    </style>

    <!-- The Spinner fills its box; padding places the selected value under the label. -->
    <style name="Kinnect.Dropdown.Spinner" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">@dimen/dropdown_padding</item>
        <item name="android:paddingTop">@dimen/dropdown_value_top</item>
        <item name="android:paddingEnd">@dimen/dropdown_value_end</item>
        <item name="android:theme">@style/ThemeOverlay.Kinnect.Spinner</item>
    </style>

    <!-- Text of the selected Spinner value: same look as a field value. Applied through the
         theme overlay below, because android:entries builds the item views itself. -->
    <style name="Kinnect.SpinnerItem" parent="">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textSize">@dimen/text_name</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Chevron at the right of a dropdown box, a little above the centre as in the design. -->
    <style name="Kinnect.DropdownChevron" parent="">
        <item name="android:layout_width">@dimen/icon_size_dropdown</item>
        <item name="android:layout_height">@dimen/icon_size_dropdown</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:layout_marginEnd">@dimen/dropdown_chevron_end</item>
        <item name="android:translationY">@dimen/dropdown_chevron_shift</item>
        <item name="android:src">@drawable/ic_chevron_down</item>
        <item name="tint">@color/text_dark</item>
    </style>

    <style name="ThemeOverlay.Kinnect.Spinner" parent="">
        <item name="android:spinnerItemStyle">@style/Kinnect.SpinnerItem</item>
    </style>

    <!-- Gender option card (03): RadioButton with the text on the left and the radio circle
         drawn on the right (drawableEnd). Both drawables are selectors, so the teal border and
         filled radio follow the checked state with no Kotlin. -->
    <style name="Kinnect.Option" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/option_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">@drawable/bg_radio</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/dropdown_padding</item>
        <item name="android:paddingEnd">@dimen/option_radio_end</item>
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textSize">@dimen/text_name</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 3dp rounded bar segment (step bar and password meter); colour via backgroundTint. -->
    <style name="Kinnect.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/progress_segment</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_segment</item>
    </style>

    <!-- ===== Chips ===== -->

    <!-- Unselected filter chip: grey pill, dark bold text. -->
    <style name="Kinnect.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/chip_padding</item>
        <item name="android:paddingEnd">@dimen/chip_padding</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Selected filter chip: light teal pill, teal text. -->
    <style name="Kinnect.Chip.Selected">
        <item name="android:background">@drawable/bg_chip_selected</item>
        <item name="android:textColor">@color/teal</item>
    </style>

    <!-- ===== Small pieces ===== -->

    <!-- Red count badge (18dp circle with a white ring). Set android:text to the number. -->
    <style name="Kinnect.Badge" parent="">
        <item name="android:layout_width">@dimen/badge_size</item>
        <item name="android:layout_height">@dimen/badge_size</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Larger badge on the recent login avatar (02): 20dp, 16dp red disc. -->
    <style name="Kinnect.Badge.Large">
        <item name="android:layout_width">@dimen/badge_size_large</item>
        <item name="android:layout_height">@dimen/badge_size_large</item>
    </style>

    <!-- Initials avatar (36dp by default). Set android:text and android:backgroundTint;
         change the size per screen with the avatar_* dimens and the text to 0.36 x that size. -->
    <style name="Kinnect.Avatar" parent="">
        <item name="android:layout_width">@dimen/avatar_36</item>
        <item name="android:layout_height">@dimen/avatar_36</item>
        <item name="android:background">@drawable/bg_avatar_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">@dimen/text_avatar</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- 1dp line between rows and under bars. -->
    <style name="Kinnect.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Thick grey gap between feed sections (04). -->
    <style name="Kinnect.SectionBand" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/section_band</item>
        <item name="android:background">@color/section_band</item>
    </style>

    <!-- 48dp icon button with no background of its own (back arrow, close, more). -->
    <style name="Kinnect.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/text_dark</item>
    </style>

    <!-- One reaction in the picker pill (05): a 32dp disc inside a 44dp touch area. -->
    <style name="Kinnect.Reaction" parent="">
        <item name="android:layout_width">@dimen/reaction_slot</item>
        <item name="android:layout_height">@dimen/reaction_slot</item>
        <item name="android:padding">@dimen/reaction_slot_padding</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Grey comment bubble: bold name on top, text below (05, 06). -->
    <style name="Kinnect.CommentBubble" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_bubble_received</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/comment_bubble_padding_h</item>
        <item name="android:paddingEnd">@dimen/comment_bubble_padding_h</item>
        <item name="android:paddingTop">@dimen/comment_bubble_padding_v</item>
        <item name="android:paddingBottom">@dimen/comment_bubble_padding_v</item>
    </style>

    <!-- ===== Top bar circles (include_top_bar.xml) =====
         Large set = Home (04). Small set = 14, 18, 19, 23, chosen per screen through
         ThemeOverlay.Kinnect.TopBarSmall in themes.xml. -->

    <!-- 48dp touch frame around the messenger circle, pinned to the right edge. -->
    <style name="Kinnect.TopBar.MessengerFrame" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:layout_marginEnd">@dimen/top_bar_end_margin</item>
        <item name="android:translationY">@dimen/top_bar_button_shift</item>
    </style>

    <style name="Kinnect.TopBar.MessengerFrame.Small">
        <item name="android:layout_marginEnd">@dimen/top_bar_end_margin_small</item>
        <item name="android:translationY">@dimen/top_bar_button_shift_small</item>
    </style>

    <!-- 48dp touch frame around the search circle; overlaps the messenger frame so the
         circles keep the design's gap. -->
    <style name="Kinnect.TopBar.SearchFrame" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:layout_marginEnd">@dimen/top_bar_button_overlap</item>
        <item name="android:translationY">@dimen/top_bar_button_shift</item>
    </style>

    <style name="Kinnect.TopBar.SearchFrame.Small">
        <item name="android:layout_marginEnd">@dimen/top_bar_button_overlap_small</item>
        <item name="android:translationY">@dimen/top_bar_button_shift_small</item>
    </style>

    <!-- Grey circle with the icon centred inside by padding. -->
    <style name="Kinnect.TopBar.Circle" parent="">
        <item name="android:layout_width">@dimen/top_bar_button</item>
        <item name="android:layout_height">@dimen/top_bar_button</item>
        <item name="android:padding">@dimen/top_bar_icon_padding</item>
    </style>

    <style name="Kinnect.TopBar.Circle.Small">
        <item name="android:layout_width">@dimen/top_bar_button_small</item>
        <item name="android:layout_height">@dimen/top_bar_button_small</item>
        <item name="android:padding">@dimen/top_bar_icon_padding_small</item>
    </style>

    <!-- Red badge on the messenger circle. -->
    <style name="Kinnect.TopBar.Badge" parent="Kinnect.Badge">
        <item name="android:translationX">@dimen/top_bar_badge_x</item>
        <item name="android:translationY">@dimen/top_bar_badge_y</item>
    </style>

    <style name="Kinnect.TopBar.Badge.Small">
        <item name="android:layout_width">@dimen/badge_size_small</item>
        <item name="android:layout_height">@dimen/badge_size_small</item>
        <item name="android:textSize">@dimen/text_badge_small</item>
        <item name="android:translationX">@dimen/top_bar_badge_x_small</item>
        <item name="android:translationY">@dimen/top_bar_badge_y_small</item>
    </style>
</resources>
