<?xml version="1.0" encoding="utf-8"?>
<!-- 44dp dark pills: Your story / Close friends (10).
     48dp touch target: the view is 48dp, the visible shape (bg_story_pill) is drawn inset so it keeps
     the design's size. The inset also counts as view padding (centred content is unaffected). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/bg_story_pill"
    android:insetLeft="0dp"
    android:insetTop="2dp"
    android:insetRight="0dp"
    android:insetBottom="2dp" />
