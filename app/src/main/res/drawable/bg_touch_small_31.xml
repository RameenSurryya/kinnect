<?xml version="1.0" encoding="utf-8"?>
<!-- 31dp teal button: Join (13).
     48dp touch target: the view is 48dp, the visible shape (bg_button_small) is drawn inset so it keeps
     the design's size. The inset also counts as view padding (centred content is unaffected). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/bg_button_small"
    android:insetLeft="0dp"
    android:insetTop="8.5dp"
    android:insetRight="0dp"
    android:insetBottom="8.5dp" />
