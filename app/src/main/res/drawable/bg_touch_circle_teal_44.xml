<?xml version="1.0" encoding="utf-8"?>
<!-- 44dp teal circle: next arrow (10).
     48dp touch target: the view is 48dp, the visible shape (bg_circle_teal) is drawn inset so it keeps
     the design's size. The inset also counts as view padding (centred content is unaffected). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/bg_circle_teal"
    android:insetLeft="2dp"
    android:insetTop="2dp"
    android:insetRight="2dp"
    android:insetBottom="2dp" />
