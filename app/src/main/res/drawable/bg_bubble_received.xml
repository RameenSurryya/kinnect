<?xml version="1.0" encoding="utf-8"?>
<!-- Chat bubble, grey bubble from the other person (left side, 06 and 21).
     A single message: all corners 18dp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chip_fill" />
    <corners
        android:topLeftRadius="@dimen/radius_bubble"
        android:topRightRadius="@dimen/radius_bubble"
        android:bottomLeftRadius="@dimen/radius_bubble"
        android:bottomRightRadius="@dimen/radius_bubble" />
</shape>