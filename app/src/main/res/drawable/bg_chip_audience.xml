<?xml version="1.0" encoding="utf-8"?>
<!-- "Public" / "Album" chips under the author name (07): light teal fill, 1dp teal outline,
     6dp corners (not a pill). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/teal_tint" />
    <stroke
        android:width="@dimen/stroke_outline"
        android:color="@color/teal" />
    <corners android:radius="@dimen/radius_label" />
</shape>
