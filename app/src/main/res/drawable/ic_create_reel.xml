<?xml version="1.0" encoding="utf-8"?>
<!-- "Create" / "Stories" icon from screens 12 and 20: a clapperboard with a play triangle.
     Phosphor has no such icon, so it is drawn by hand in the Phosphor style
     (256 viewport, 16-unit strokes, round ends). Black, tinted in layouts with app:tint. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

    <!-- Rounded square frame, the line under the clapper band, and its two slanted stripes -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="16"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M64,50L192,50A20,20 0,0 1,212 70L212,186A20,20 0,0 1,192 206L64,206A20,20 0,0 1,44 186L44,70A20,20 0,0 1,64 50Z
            M44,98L212,98M92,50L108,98M150,50L166,98" />

    <!-- Play triangle (thick outline with round corners, leaving a small hole) -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="16"
        android:strokeLineJoin="round"
        android:pathData="M110,136L146,161L110,186Z" />
</vector>
