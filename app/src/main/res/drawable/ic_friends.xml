<?xml version="1.0" encoding="utf-8"?>
<!-- Friends icon, drawn by hand from the Friends tab of screens 04, 14, 18, 19 and 23 (also the
     Groups shortcut in 19): a person in front (round head, arched shoulders) and a second person
     behind on the right, of whom only the right half of the head and one shoulder show.
     256 viewport like Phosphor, round line ends, 20-unit strokes (the design's lines are a little
     heavier than Phosphor's 16). Black, tinted with app:tint.
     Geometry measured with tools/px.py and checked with tools/check_glyphs.py. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

    <!-- Front person: head, a full circle (centre 103.5,86, radius 38) -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="20"
        android:pathData="M141.5,86A38,38 0,1 1,65.5 86A38,38 0,1 1,141.5 86Z" />

    <!-- Front person: shoulders, an arch on a circle (centre 103.5,225, radius 66.7) -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="20"
        android:strokeLineCap="round"
        android:pathData="M38.1,211.8A66.7,66.7 0,0 1,168.9 211.8" />

    <!-- Back person: right half of the head (centre 170,86, radius 34) -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="20"
        android:strokeLineCap="round"
        android:pathData="M176.5,52.6A34,34 0,0 1,176.5 119.4" />

    <!-- Back person: right shoulder, the front arch moved right (centre 170,225, radius 66.7) -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="20"
        android:strokeLineCap="round"
        android:pathData="M193,162.4A66.7,66.7 0,0 1,235.4 211.8" />
</vector>
