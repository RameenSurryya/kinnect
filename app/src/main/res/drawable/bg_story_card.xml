<?xml version="1.0" encoding="utf-8"?>
<!-- Friend story card (04): 12dp rounded rectangle. HomeActivity turns on clipToOutline for
     these cards, so the photo and the dark name strip inside are cut to the same corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/camera_bg" />
    <corners android:radius="@dimen/radius_card" />
</shape>
