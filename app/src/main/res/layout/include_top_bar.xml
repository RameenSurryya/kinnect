<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared top bar of the tab screens (04, 14, 18, 19, 23): the page title (or the "kinnect"
    wordmark on Home) on the left, and the search and messenger circles on the right.
    BaseActivity.setupTopBar() / setupHomeTopBar() set the title and wire the two buttons.

    Two sizes, picked by the including screen with no code:
      Home (04):          <include layout="@layout/include_top_bar" />
      14, 18, 19, 23:     <include layout="@layout/include_top_bar"
                              android:theme="@style/ThemeOverlay.Kinnect.TopBarSmall" />
    The circles, badge and touch frames take their sizes from style="?attr/topBar...Style":
    the app theme points those at the large styles, the overlay at the small ones (styles.xml).

    Measured: row 48dp; title 1dp below the row centre. Large (04): circles 36dp, 8dp apart,
    16dp from the right edge, y 8-44, 19dp icons, 18dp badge. Small (14-23): circles 31dp,
    6.5dp apart, 18dp from the edge, centred at y 27, 16dp icons, 15dp badge.
    Each circle sits in a 48dp FrameLayout (the touch target); the frames overlap (negative
    margin) so the circles keep the design's gap. A paddingTop on each frame moves the circle
    a little below the row centre while the whole 48dp frame stays inside the bar.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height">

    <!-- Page title (Friends, Notifications, Menu, Marketplace). Hidden on Home. -->
    <TextView
        android:id="@+id/tv_top_title"
        style="@style/Kinnect.Text.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_toStartOf="@+id/fl_search"
        android:translationY="@dimen/top_bar_title_shift"
        android:ellipsize="end"
        android:singleLine="true"
        tools:text="Friends" />

    <!-- "kinnect" wordmark, shown instead of the title on Home. -->
    <TextView
        android:id="@+id/tv_wordmark"
        style="@style/Kinnect.Text.Wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/screen_margin"
        android:text="@string/wordmark"
        android:translationY="@dimen/top_bar_title_shift"
        android:visibility="gone" />

    <!-- Messenger button: grey circle, icon, red unread badge -->
    <FrameLayout
        android:id="@+id/fl_messenger"
        style="?attr/topBarMessengerFrameStyle"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_messenger">

        <ImageView
            android:id="@+id/iv_messenger"
            style="?attr/topBarCircleStyle"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_grey"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_messenger"
            app:tint="@color/text_dark" />

        <TextView
            android:id="@+id/tv_messenger_badge"
            style="?attr/topBarBadgeStyle"
            android:layout_gravity="center"
            android:text="@string/sample_badge_messages" />
    </FrameLayout>

    <!-- Search button: grey circle and icon -->
    <FrameLayout
        android:id="@+id/fl_search"
        style="?attr/topBarSearchFrameStyle"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/fl_messenger"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_search">

        <ImageView
            android:id="@+id/iv_search"
            style="?attr/topBarCircleStyle"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_grey"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/text_dark" />
    </FrameLayout>
</RelativeLayout>
