<?xml version="1.0" encoding="utf-8"?>
<!--
    02 Login: language row, teal logo tile, the recent-login card, e-mail and password fields,
    Log in, Forgot password?, and at the bottom Create new account and the footer.

    ScrollView with fillViewport: on a tall phone the content fills the screen and the empty
    weighted View pushes "Create new account" and the footer to the bottom (as in the design);
    on a short phone, or with the keyboard open, everything scrolls together instead.
    Measurements in dp come from design/screens/screen-02.png (20dp side margins).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <!-- focusableInTouchMode: the screen opens without a blinking cursor in the first field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin_auth"
        android:paddingEnd="@dimen/screen_margin_auth">

        <!-- Language: "English (UK)" and a small caret, centred (display only) -->
        <LinearLayout
            android:id="@+id/ll_language"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/login_language_top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_language"
                style="@style/Kinnect.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_language"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_label" />

            <ImageView
                android:id="@+id/iv_language_chevron"
                android:layout_width="@dimen/icon_size_chevron"
                android:layout_height="@dimen/icon_size_chevron"
                android:layout_marginStart="@dimen/login_chevron_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_grey" />
        </LinearLayout>

        <!-- Teal app tile with the white logo (padding places the logo a little above centre) -->
        <ImageView
            android:id="@+id/iv_logo_tile"
            android:layout_width="@dimen/logo_tile"
            android:layout_height="@dimen/logo_tile"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/logo_tile_top"
            android:background="@drawable/bg_logo_tile"
            android:contentDescription="@string/app_name"
            android:paddingStart="@dimen/logo_tile_pad_side"
            android:paddingTop="@dimen/logo_tile_pad_top"
            android:paddingEnd="@dimen/logo_tile_pad_side"
            android:paddingBottom="@dimen/logo_tile_pad_bottom"
            android:src="@drawable/logo_kinnect" />

        <TextView
            android:id="@+id/tv_recent_login"
            style="@style/Kinnect.Text.Label.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_label_top"
            android:text="@string/login_recent" />

        <!-- Recent login card: tap it to log in as Jacob West (opens Home) -->
        <LinearLayout
            android:id="@+id/ll_recent_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_card_height"
            android:layout_marginTop="@dimen/login_card_top"
            android:background="@drawable/bg_card_outline"
            android:clickable="true"
            android:contentDescription="@string/cd_recent_login"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/login_card_pad_start">

            <!-- Avatar with the red "2" badge on its top-right edge. FrameLayout stacks its
                 children: the badge (top|end) is drawn over the avatar. The avatar's top and
                 end margins leave room for the half of the badge that sticks out. -->
            <FrameLayout
                android:id="@+id/fl_recent_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_recent_avatar"
                    style="@style/Kinnect.Avatar"
                    android:layout_width="@dimen/avatar_52"
                    android:layout_height="@dimen/avatar_52"
                    android:layout_marginTop="@dimen/login_avatar_frame_top"
                    android:layout_marginEnd="@dimen/login_avatar_frame_end"
                    android:layout_marginBottom="@dimen/login_avatar_frame_top"
                    android:backgroundTint="@color/avatar_jw"
                    android:text="@string/sample_initials_jacob"
                    android:textSize="@dimen/text_avatar_52" />

                <TextView
                    android:id="@+id/tv_recent_badge"
                    style="@style/Kinnect.Badge.Large"
                    android:layout_gravity="top|end"
                    android:importantForAccessibility="no"
                    android:text="@string/sample_badge_login" />
            </FrameLayout>

            <!-- Name and "Tap to log in" take the remaining width -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/login_name_start"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_recent_name"
                    style="@style/Kinnect.Text.Name.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/sample_name_jacob" />

                <TextView
                    android:id="@+id/tv_recent_hint"
                    style="@style/Kinnect.Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/login_hint_top"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/login_tap_to_log_in" />
            </LinearLayout>

            <!-- Three dots: a button with no screen behind it, so it does nothing (clickable
                 stops the tap from reaching the card). A small negative margin and
                 translationY centre the 48dp touch target where the design puts the dots. -->
            <ImageView
                android:id="@+id/iv_recent_more"
                style="@style/Kinnect.IconButton"
                android:layout_marginEnd="@dimen/login_more_end"
                android:translationY="@dimen/login_more_shift"
                android:clickable="true"
                android:contentDescription="@string/cd_more"
                android:focusable="true"
                android:src="@drawable/ic_more"
                app:tint="@color/text_grey" />
        </LinearLayout>

        <!-- E-mail field: small label above the value -->
        <LinearLayout
            android:id="@+id/ll_email"
            style="@style/Kinnect.Field"
            android:layout_marginTop="@dimen/login_fields_top">

            <TextView
                android:id="@+id/tv_email_label"
                style="@style/Kinnect.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/et_email"
                android:text="@string/login_email_label" />

            <EditText
                android:id="@+id/et_email"
                style="@style/Kinnect.FieldText"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress"
                android:text="@string/sample_email" />
        </LinearLayout>

        <!-- Password field: label and dots on the left, eye button on the right -->
        <LinearLayout
            android:id="@+id/ll_password"
            style="@style/Kinnect.Field"
            android:layout_height="@dimen/input_height_password"
            android:layout_marginTop="@dimen/login_field_gap"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/login_eye_end">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_password_label"
                    style="@style/Kinnect.Text.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/et_password"
                    android:text="@string/login_password_label" />

                <EditText
                    android:id="@+id/et_password"
                    style="@style/Kinnect.FieldText"
                    android:autofillHints="password"
                    android:inputType="textPassword"
                    android:text="@string/sample_password" />
            </LinearLayout>

            <!-- Eye: shows or hides the password (LoginActivity) -->
            <ImageView
                android:id="@+id/iv_password_eye"
                style="@style/Kinnect.IconButton"
                android:contentDescription="@string/cd_show_password"
                android:padding="@dimen/login_eye_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_grey" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_login"
            style="@style/Kinnect.Button.Primary"
            android:layout_marginTop="@dimen/login_button_top"
            android:text="@string/login_button" />

        <!-- Teal link; there is no Forgot password screen, so it is plain text -->
        <TextView
            android:id="@+id/tv_forgot_password"
            style="@style/Kinnect.Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/login_forgot_top"
            android:text="@string/login_forgot" />

        <!-- Empty space that grows to push the next views to the bottom of the screen -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_32" />

        <Button
            android:id="@+id/btn_create_account"
            style="@style/Kinnect.Button.Outline"
            android:text="@string/login_create_account" />

        <!-- Footer: small grey logo and "Kinnect · from SMD" -->
        <LinearLayout
            android:id="@+id/ll_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/login_create_bottom"
            android:layout_marginBottom="@dimen/login_footer_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_footer_logo"
                android:layout_width="@dimen/footer_logo"
                android:layout_height="@dimen/footer_logo"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_kinnect"
                app:tint="@color/text_grey" />

            <TextView
                android:id="@+id/tv_footer"
                style="@style/Kinnect.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/footer_logo_gap"
                android:text="@string/login_footer" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
