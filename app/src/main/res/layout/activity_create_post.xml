<?xml version="1.0" encoding="utf-8"?>
<!--
    07 Create post. Pinned at the top: toolbar (X, "Create post", teal "Post" pill).
    Pinned at the bottom: the white bottom sheet (rounded top corners, grey handle, seven rows).
    In between a ScrollView holds the author row, the large post text and the background
    swatches; the empty white space above the sheet is just the screen background.
    The sheet's shadow comes from android:elevation on its rounded background.
    Measurements in dp come from design/screens/screen-07.png (dimens.xml, Create post section).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== Toolbar: X, "Create post", Post ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_close"
            style="@style/Kinnect.IconButton"
            android:contentDescription="@string/cd_close"
            android:padding="@dimen/close_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />

        <TextView
            style="@style/Kinnect.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/create_post_title" />

        <!-- Teal pill (33dp, drawn inside a 48dp touch target); Post goes back to Home -->
        <Button
            android:id="@+id/btn_post"
            style="@style/Kinnect.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/post_button_end"
            android:background="@drawable/bg_touch_primary_33"
            android:text="@string/create_post_button"
            android:textColor="@color/white"
            android:textSize="@dimen/text_name" />
    </LinearLayout>

    <View style="@style/Kinnect.Divider" />

    <!-- ===== Post being written ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/create_author_top"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <!-- Author row: JW avatar, then the name with the two audience chips under it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Kinnect.Avatar"
                    android:layout_width="@dimen/avatar_44"
                    android:layout_height="@dimen/avatar_44"
                    android:backgroundTint="@color/avatar_jw"
                    android:text="@string/sample_initials_jacob"
                    android:textSize="@dimen/text_avatar_44" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/create_name_gap"
                    android:layout_marginTop="@dimen/create_name_top"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:singleLine="true"
                        android:text="@string/sample_name_jacob"
                        android:textSize="@dimen/text_name" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/create_chips_top"
                        android:orientation="horizontal">

                        <!-- Globe + "Public" + chevron (visual only) -->
                        <LinearLayout
                            style="@style/Kinnect.AudienceChip"
                            android:contentDescription="@string/cd_audience">

                            <ImageView
                                style="@style/Kinnect.AudienceChip.Icon"
                                android:src="@drawable/ic_globe" />

                            <TextView
                                style="@style/Kinnect.Text.AudienceChip"
                                android:text="@string/create_post_public" />

                            <ImageView style="@style/Kinnect.AudienceChip.Chevron" />
                        </LinearLayout>

                        <!-- "+ Album" + chevron (visual only) -->
                        <LinearLayout
                            style="@style/Kinnect.AudienceChip"
                            android:layout_marginStart="@dimen/audience_chip_gap"
                            android:contentDescription="@string/cd_add_to_album">

                            <ImageView
                                style="@style/Kinnect.AudienceChip.Icon"
                                android:src="@drawable/ic_plus" />

                            <TextView
                                style="@style/Kinnect.Text.AudienceChip"
                                android:text="@string/create_post_album" />

                            <ImageView style="@style/Kinnect.AudienceChip.Chevron" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- The post text in the large size used for short posts -->
            <TextView
                android:id="@+id/tv_post_text"
                style="@style/Kinnect.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/create_text_top"
                android:lineSpacingExtra="@dimen/post_large_line_spacing"
                android:text="@string/sample_create_post_text"
                android:textSize="@dimen/text_post_large" />

            <!-- Background swatches: "Aa" (plain, selected) then seven colours. Visual only. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/swatch_row_top"
                android:orientation="horizontal">

                <TextView
                    style="@style/Kinnect.Text"
                    android:layout_width="@dimen/swatch_size"
                    android:layout_height="@dimen/swatch_size"
                    android:background="@drawable/bg_swatch_selected"
                    android:contentDescription="@string/cd_bg_plain"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/create_post_aa"
                    android:textSize="@dimen/text_label" />

                <View
                    style="@style/Kinnect.Swatch"
                    android:backgroundTint="@color/teal"
                    android:contentDescription="@string/cd_bg_teal" />

                <View
                    style="@style/Kinnect.Swatch"
                    android:backgroundTint="@color/accent_orange"
                    android:contentDescription="@string/cd_bg_orange" />

                <View
                    style="@style/Kinnect.Swatch"
                    android:backgroundTint="@color/indigo"
                    android:contentDescription="@string/cd_bg_indigo" />

                <View
                    style="@style/Kinnect.Swatch"
                    android:backgroundTint="@color/green"
                    android:contentDescription="@string/cd_bg_green" />

                <View
                    style="@style/Kinnect.Swatch"
                    android:backgroundTint="@color/mustard"
                    android:contentDescription="@string/cd_bg_mustard" />

                <View
                    style="@style/Kinnect.Swatch"
                    android:backgroundTint="@color/purple"
                    android:contentDescription="@string/cd_bg_purple" />

                <View
                    style="@style/Kinnect.Swatch"
                    android:backgroundTint="@color/text_dark"
                    android:contentDescription="@string/cd_bg_black" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Bottom sheet: handle + seven "add to your post" rows ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="@dimen/sheet_elevation"
        android:orientation="vertical"
        android:paddingBottom="@dimen/sheet_rows_bottom">

        <!-- Grey drag handle (decoration only) -->
        <View
            android:layout_width="@dimen/sheet_handle_width"
            android:layout_height="@dimen/sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sheet_handle_top"
            android:layout_marginBottom="@dimen/sheet_rows_top"
            android:background="@drawable/bg_segment"
            android:backgroundTint="@color/track" />

        <!-- Photo/video opens the Photo picker -->
        <LinearLayout
            android:id="@+id/ll_photo_video"
            style="@style/Kinnect.SheetRow">

            <ImageView
                style="@style/Kinnect.SheetRow.Icon"
                android:src="@drawable/ic_image"
                app:tint="@color/green" />

            <TextView
                style="@style/Kinnect.Text.SheetRow"
                android:text="@string/create_photo_video" />
        </LinearLayout>

        <LinearLayout style="@style/Kinnect.SheetRow">

            <ImageView
                style="@style/Kinnect.SheetRow.Icon"
                android:src="@drawable/ic_tag"
                app:tint="@color/steel_blue" />

            <TextView
                style="@style/Kinnect.Text.SheetRow"
                android:text="@string/create_tag_people" />
        </LinearLayout>

        <LinearLayout style="@style/Kinnect.SheetRow">

            <ImageView
                style="@style/Kinnect.SheetRow.Icon"
                android:src="@drawable/ic_smile"
                app:tint="@color/mustard" />

            <TextView
                style="@style/Kinnect.Text.SheetRow"
                android:text="@string/create_feeling" />
        </LinearLayout>

        <LinearLayout style="@style/Kinnect.SheetRow">

            <ImageView
                style="@style/Kinnect.SheetRow.Icon"
                android:src="@drawable/ic_pin"
                app:tint="@color/accent_orange" />

            <TextView
                style="@style/Kinnect.Text.SheetRow"
                android:text="@string/create_check_in" />
        </LinearLayout>

        <LinearLayout style="@style/Kinnect.SheetRow">

            <ImageView
                style="@style/Kinnect.SheetRow.Icon"
                android:src="@drawable/ic_live"
                app:tint="@color/maroon" />

            <TextView
                style="@style/Kinnect.Text.SheetRow"
                android:text="@string/create_live_video" />
        </LinearLayout>

        <!-- Camera opens the Camera screen -->
        <LinearLayout
            android:id="@+id/ll_camera"
            style="@style/Kinnect.SheetRow">

            <ImageView
                style="@style/Kinnect.SheetRow.Icon"
                android:src="@drawable/ic_camera"
                app:tint="@color/teal" />

            <TextView
                style="@style/Kinnect.Text.SheetRow"
                android:text="@string/create_camera" />
        </LinearLayout>

        <LinearLayout style="@style/Kinnect.SheetRow">

            <ImageView
                style="@style/Kinnect.SheetRow.Icon"
                android:src="@drawable/ic_calendar"
                app:tint="@color/indigo" />

            <TextView
                style="@style/Kinnect.Text.SheetRow"
                android:text="@string/create_event" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
