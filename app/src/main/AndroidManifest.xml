<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Every Activity is locked to portrait (phones only, see CLAUDE.md). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kinnect">

        <!-- 01 Splash: the launcher screen, teal from the first frame. -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kinnect.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 02 Login -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 03 Sign up -->
        <activity
            android:name=".ui.auth.SignUpActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 04 Home feed -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:screenOrientation="portrait" />

        <!-- Placeholders (screen background only) until each screen is built -->
        <!-- 05 Reaction picker -->
        <activity
            android:name=".ui.home.ReactionPickerActivity"
            android:screenOrientation="portrait" />

        <!-- 06 Comments -->
        <activity
            android:name=".ui.home.CommentsActivity"
            android:screenOrientation="portrait" />

        <!-- 07 Create post -->
        <activity
            android:name=".ui.home.CreatePostActivity"
            android:screenOrientation="portrait" />

        <!-- 08 Photo picker -->
        <activity
            android:name=".ui.home.PhotoPickerActivity"
            android:screenOrientation="portrait" />

        <!-- 09 Camera -->
        <activity
            android:name=".ui.home.CameraActivity"
            android:screenOrientation="portrait" />

        <!-- 10 Story editor -->
        <activity
            android:name=".ui.home.StoryEditorActivity"
            android:screenOrientation="portrait" />

        <!-- 11 Story viewer -->
        <activity
            android:name=".ui.home.StoryViewerActivity"
            android:screenOrientation="portrait" />

        <!-- 12 Your story -->
        <activity
            android:name=".ui.home.YourStoryActivity"
            android:screenOrientation="portrait" />

        <!-- 13 Search -->
        <activity
            android:name=".ui.home.SearchActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- 14 Friends -->
        <activity
            android:name=".ui.social.FriendsActivity"
            android:screenOrientation="portrait" />

        <!-- 15 Profile -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:screenOrientation="portrait" />

        <!-- 16 Edit profile -->
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- 17 Other profile -->
        <activity
            android:name=".ui.profile.OtherProfileActivity"
            android:screenOrientation="portrait" />

        <!-- 18 Notifications -->
        <activity
            android:name=".ui.social.NotificationsActivity"
            android:screenOrientation="portrait" />

        <!-- 19 Menu -->
        <activity
            android:name=".ui.social.MenuActivity"
            android:screenOrientation="portrait" />

        <!-- 20 Chats -->
        <activity
            android:name=".ui.chat.ChatsActivity"
            android:screenOrientation="portrait" />

        <!-- 21 Chat -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:screenOrientation="portrait" />

        <!-- 23 Marketplace -->
        <activity
            android:name=".ui.market.MarketplaceActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>
